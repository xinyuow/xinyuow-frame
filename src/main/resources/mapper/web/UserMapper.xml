<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinyuow.frame.web.mapper.UserMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.xinyuow.frame.web.entity.User">
        <id column="id" property="id" />
        <result column="login_name" property="loginName" />
        <result column="login_password" property="loginPassword" />
        <result column="username" property="username" />
        <result column="status" property="status" />
        <result column="login_fail_count" property="loginFailCount" />
        <result column="lock_flag" property="lockFlag" />
        <result column="locked_date" property="lockedDate" />
        <result column="create_date" property="createDate" />
        <result column="modify_date" property="modifyDate" />
        <result column="del_flag" property="delFlag" />
    </resultMap>

    <!-- 级联查询返回的map -->
    <resultMap id="joinUserMap" type="com.xinyuow.frame.web.entity.User">
        <id column="id" property="id" />
        <result column="login_name" property="loginName" />
        <result column="login_password" property="loginPassword" />
        <result column="username" property="username" />
        <result column="status" property="status" />
        <result column="login_fail_count" property="loginFailCount" />
        <result column="lock_flag" property="lockFlag" />
        <result column="locked_date" property="lockedDate" />
        <result column="create_date" property="createDate" />
        <result column="modify_date" property="modifyDate" />
        <result column="del_flag" property="delFlag" />

        <!-- 级联查询用户对应角色 -->
        <collection property="roles"
                    ofType="com.xinyuow.frame.web.entity.Role"
                    javaType="java.util.ArrayList"
                    select="com.xinyuow.quotes.web.mapper.RoleMapper.getById"
                    column="role_id">
        </collection>
    </resultMap>

    <!-- 查询用户并级联查询用户角色 -->
    <select id="getUserCascadeRole" resultMap="joinUserMap" parameterType="java.lang.Long">
        SELECT
            U.id, U.login_name, U.user_name, U.login_pwd, U.status, U.login_fail_cnt, U.lock_flag,
            U.locked_date, U.create_date, U.modify_date, U.del_flag,
            UR.role_id AS role_id
        FROM s_user U
        LEFT JOIN s_user_role AS UR ON U.id = UR.user_id
        LEFT JOIN s_role AS R ON UR.role_id = R.id
        WHERE U.id = #{userId}
    </select>

</mapper>
